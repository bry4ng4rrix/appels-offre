# Copier en ".env" et remplir.

# Django
DEBUG=True
# Obligatoire hors DEBUG : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 1 derriere un proxy HTTPS (cookies Secure, HSTS)
DERRIERE_TLS=0

# Base PostgreSQL (port 5434 : docker compose up -d db)
DATABASE_URL=postgresql://veille:veille@127.0.0.1:5434/veille
# Pour essayer sans PostgreSQL : DATABASE_URL=sqlite:///db.sqlite3

# Collecte automatique : heure initiale (Indian/Antananarivo) du passage quotidien.
# Ensuite, elle se regle dans l'onglet Parametres de l'interface.
VEILLE_HEURE=06:00

# Classement IA facultatif. Sur l'hôte : `ollama pull gemma3:1b`.
# Avec Docker : `docker compose --profile ia up -d ollama`, puis
# `docker compose exec ollama ollama pull gemma3:1b`.
# Mettre CLASSIFICATEUR_IA=ollama pour appeler Gemma sur les offres classées "autre".
CLASSIFICATEUR_IA=off
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT=45

# Email recapitulatif. Sans SMTP_HOST, les emails s'affichent sur la console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Plusieurs destinataires : separes par des virgules
NOTIFY_TO=

# Connexion Google (OAuth 2.0). Console Google Cloud > API et services > Identifiants,
# client « Application Web ». URI de redirection autorisée :
#   https://<votre-domaine>/comptes/google/login/callback/
#   http://localhost:8000/comptes/google/login/callback/   (développement)
# Vides : le bouton « Continuer avec Google » n'apparaît pas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Adresse publique du site : liens des emails d'alerte (sans / final).
SITE_URL=

# Premier administrateur : manage.py creer_admin --email vous@exemple.org
# (aucune page ne permet de s'inscrire administrateur).

# API publique (/api/public/, sans jeton). UNjobnet et la BAD interdisent la
# rediffusion sans accord ecrit : les lister ici les retire. Vide = tout.
API_PUBLIQUE_SOURCES_EXCLUES=
API_PUBLIQUE_ORIGINES=*
