# Copier en ".env" et remplir.

# Django
DEBUG=True
# Obligatoire hors DEBUG : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 1 derriere un proxy HTTPS (cookies Secure, HSTS)
DERRIERE_TLS=0

# Base PostgreSQL (port 5434 : docker compose up -d db)
DATABASE_URL=postgresql://veille:veille@127.0.0.1:5434/veille
# Pour essayer sans PostgreSQL : DATABASE_URL=sqlite:///db.sqlite3

# Email recapitulatif. Sans SMTP_HOST, les emails s'affichent sur la console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Plusieurs destinataires : separes par des virgules
NOTIFY_TO=

# API publique (/api/public/, sans jeton). UNjobnet et la BAD interdisent la
# rediffusion sans accord ecrit : les lister ici les retire. Vide = tout.
API_PUBLIQUE_SOURCES_EXCLUES=
API_PUBLIQUE_ORIGINES=*
