# Interface web de la veille.
#   sudo cp deploiement/veille-*.service deploiement/veille-*.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now veille-web.service

[Unit]
Description=Veille appels d'offres - interface web
# La base tourne dans Docker : demarrer avant elle ne servirait a rien.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=veille
Group=veille
WorkingDirectory=/opt/veille/app
EnvironmentFile=/opt/veille/.env
ExecStart=/opt/veille/venv/bin/gunicorn \
    --config /opt/veille/app/deploiement/gunicorn.conf.py \
    --chdir /opt/veille/app \
    Offre.wsgi:application
Restart=on-failure
RestartSec=5

# Le service n'a besoin d'ecrire que dans son propre repertoire.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veille

[Install]
WantedBy=multi-user.target
