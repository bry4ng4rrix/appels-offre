# Traitement complet quotidien (collecte, tri, liens), sur le serveur.
# `planifier --une-fois` en fait une Tache : le passage apparait, avec sa
# progression et son journal, dans la page Taches de l'interface.
#
# La qualification utilise les regles Python ; si CLASSIFICATEUR_IA=ollama,
# Gemma 3:1b via Ollama traite seulement les offres que les regles classent
# "autre". En cas de panne Ollama, les regles restent le secours.
#
# Declenche par veille-collecte.timer, jamais directement.

[Unit]
Description=Veille appels d'offres - collecte et qualification quotidiennes
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=veille
Group=veille
WorkingDirectory=/opt/veille/app
EnvironmentFile=/opt/veille/.env
ExecStart=/opt/veille/venv/bin/python /opt/veille/app/manage.py planifier --une-fois

# Collecte des treize sources : environ une heure, UNjobnet en prend dix
# minutes a elle seule. Tri d'une centaine d'offres a 3,5/min : une demi-heure.
# Trois heures laissent de la marge pour une journee chargee, au-dela il vaut
# mieux couper que laisser un run bloque jusqu'au suivant.
TimeoutStartSec=10800

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/veille
